shots/
work/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
launcher/hs_err_pid*.log
launcher/replay_pid*.log

# Wallpaper videos are checksum-verified downloads from GitHub Releases.
themes/custom-version/*.mov
themes/custom-version/*.part

# Background assets are release downloads; previews are no longer packaged.
themes/custom-version/wallpaper_*.png
